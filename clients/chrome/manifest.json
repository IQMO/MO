{
  "manifest_version": 3,
  "name": "MO Connected Tab",
  "version": "1.0.3",
  "description": "Let MO Agent discover Chrome tabs and connect to the tab you ask it to use.",
  "minimum_chrome_version": "118",
  "incognito": "not_allowed",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "icons": {
    "16": "icons/mo-16.png",
    "32": "icons/mo-32.png",
    "48": "icons/mo-48.png",
    "128": "icons/mo-128.png"
  },
  "action": {
    "default_title": "MO connects when you ask it to use this tab",
    "default_icon": {
      "16": "icons/mo-16.png",
      "32": "icons/mo-32.png",
      "48": "icons/mo-48.png",
      "128": "icons/mo-128.png"
    }
  },
  "key": ""
}
