"""Copy this file to ``interface/skins/<skin_id>.py`` and replace every color."""
from .model import Skin


# Keep the exported name exactly ``SKIN``. Every value is semantic rather than
# surface-specific geometry; Desktop padding/radius and window-effect choices
# remain Settings-controlled. ``brand_glow`` automatically colors Glow/Hybrid.
