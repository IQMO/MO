    bg_deepest="#010101",
    bg_dark="#090b10",
    bg_surface="#111722",
    bg_input="#0b1228",
    text_primary="#d7dee8",
    text_secondary="#bbccdd",
    text_dim="#666666",
    text_muted="#7d8996",
    text_bright="#ffffff",
    text_placeholder="#555555",
    text_code="#a0c4ff",
    border_default="#314253",
    border_focus="#3f6dd9",
    brand_primary="#00cccc",
    brand_glow="#3fe0e0",
    accent_blue="#7aa2ff",
    accent_green="#68d391",
    accent_amber="#f6ad55",
    accent_warning="#ffae42",
    accent_red="#fc8181",
    accent_red_soft="#cc4444",
    accent_critical="#ff4444",
    accent_purple="#bb86fc",
    accent_yellow="#ffd166",
    accent_info="#66d9ef",
    status_done="#00cc88",
    status_active="#ddaa00",
    status_blocked="#cc4444",
    status_pending="#666666",
    user_msg_bg="#12242e",
    selected_bg="#005f5f",
